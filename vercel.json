{
  "headers": [
    {"source":"/(.*\\.html)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"},{"key":"Service-Worker-Allowed","value":"/"}]},
    {"source":"/css/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
    {"source":"/js/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{"source":"/404","destination":"/404.html"}],
  "redirects": [
    {"source":"/home","destination":"/","permanent":true},
    {"source":"/index","destination":"/","permanent":true}
  ]
}
